# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agritech?retryWrites=true&w=majority

# Backend Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_here

# OpenWeatherMap API Key (Free tier)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Allowed Frontend Origins for CORS (comma-separated)
CLIENT_URL=http://localhost:5173,https://your-agritech-frontend.vercel.app

